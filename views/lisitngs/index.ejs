<% layout("/layouts/boilerplate") %> 
<style>
   #filters{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
   }
   .filter{
      text-align: center;
      margin-right: 2rem;
      margin-top: 2rem;
      opacity: 0.7;
   }
   .filter:hover{
      opacity: 1;
      cursor: pointer;
   }
   .filter p {
      font-size: 0.9rem;
   }
   .tax-info{
      display: none;
   }

   .tax-toggle{
      border: 1px solid black;
      border-radius: 1rem;
      height: 3.25rem;
      padding: 1rem;
      margin-left: 3rem;
      display: flex;
      align-items: center;

   }
   .listing-img{
  height: 20rem;
  object-fit: cover;
}
@media (max-width: 768px){
  .listing-img{
    height: 14rem;
  }
}
@media (max-width: 768px){
  #filters{
    flex-wrap: nowrap;
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }
  #filters::-webkit-scrollbar{
    display: none;
  }
  .filter{
    flex: 0 0 auto;
    margin-right: 1.2rem;
    margin-top: 1rem;
  }
  .tax-toggle{
    flex: 0 0 auto;
    margin-left: 1rem;
    white-space: nowrap;
  }
}
   
</style>

    <!-- <h3>All listings</h3> -->
     <% if (typeof category !== "undefined" && category) { %>
  <h5>Showing listings for: <%= category %></h5>
<% } %>
 <div id="filters">
    <a href="/listings/<%= encodeURIComponent('Trending') %>" class="filter" style="text-decoration:none; color:inherit;">
    <div><i class="fa-solid fa-fire"></i></div> 
    <p> Trending</p>
    </a>
  
     <a href="/listings/<%= encodeURIComponent('Rooms') %>" class="filter" style="text-decoration:none; color:inherit;">
    <div><i class="fa-solid fa-fire"></i></div> 
    <p>Rooms</p>
     </a>
           <a href="/listings/<%= encodeURIComponent('Iconic cities') %>" class="filter" style="text-decoration:none; color:inherit;">
    <div><i class="fa-solid fa-mountain"></i></div> 
    <p>Iconic cities</p>
    </a>
      <a href="/listings/<%= encodeURIComponent('Mountains') %>" class="filter" style="text-decoration:none; color:inherit;">
    <div><i class="fa-solid fa-mountain"></i></div> 
    <p>Mountains</p>
    </a>
   <a href="/listings/<%= encodeURIComponent('Castles') %>" class="filter" style="text-decoration:none; color:inherit;">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p> Castles</p>
    </a>
            
       <a href="/listings/<%= encodeURIComponent('Amazing Pools') %>" class="filter" style="text-decoration:none; color:inherit;">
           <div><i class="fa-solid fa-person-swimming"></i></i></div> 
          <p>Amazing Pools</p>
        </a>

       <a href="/listings/<%= encodeURIComponent('Camping') %>" class="filter" style="text-decoration:none; color:inherit;">
             <div><i class="fa-solid fa-campground"></i></div> 
          <p>Camping</p>
        </a>

       <a href="/listings/<%= encodeURIComponent('Farm') %>" class="filter" style="text-decoration:none; color:inherit;">
           <div><i class="fa-solid fa-cow"></i></div> 
          <p>Farm</p>
        </a>

       <a href="/listings/<%= encodeURIComponent('Arctic') %>" class="filter" style="text-decoration:none; color:inherit;">
          <div><i class="fa-solid fa-igloo"></i></div> 
          <p>Arctic</p>
        </a>

     <a href="/listings/<%= encodeURIComponent('Domes') %>" class="filter" style="text-decoration:none; color:inherit;">
         <div><i class="fa-solid fa-landmark-dome"></i></div> 
          <p>Domes</p>
        </a>
        
    <a href="/listings/<%= encodeURIComponent('Boats') %>" class="filter" style="text-decoration:none; color:inherit;">
          <div><i class="fa-solid fa-ship"></i></div> 
          <p>Boats</p>
     </a>
     
      <div class="tax-toggle">
         <div class="form-check-reverse form-switch">
               <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
         </div>
      </div>

    </div>
    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">
         <% for(let listing of allListings){ %>
            <a href="/listings/<%=listing._id%>" class="listing-link">
   <div class="card col listing-card">
  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" style="height: 20rem;">
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text"> <b><%= listing.title %></b><br>
       &#8377; <%=listing.price%> /night
       <i class="tax-info"> &nbsp; &nbsp;18% GST</i>
    </p>
</div>
</div>
          </a>
 <% } %>
    </div>
   
<script>
   let taxSwitch = document.getElementById("switchCheckDefault");
   taxSwitch.addEventListener("click", ()=>{
   let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
          info.style.display = "inline";
      }else{
          info.style.display = "none";
      }
      
    }
   })
</script>    
   

